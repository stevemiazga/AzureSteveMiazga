@{
    ViewData["Title"] = "Steve Miazga - Steve's Video Store";
}

<div class="container py-4">
    <div class="bg-light p-5 rounded mb-4">
        <div class="row">
            <div class="col-12">
                <h4 class="text-center">Steve Miazga - Steve's Video Store Video</h4>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <p>
                    Steve's Video Store is a mock website I did in 2014. It uses ASP.NET MVC 5, Entity Framework 6, and bootstrap. The site is responsive to desktop and mobile devices. 
                    There is a view switcher to switch to desktop and mobile. The mobile view has more of a mobile app look that uses jquery mobile.
                </p>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="ratio ratio-16x9">
                <video id="myVideo" autoplay muted playsinline loop preload="auto" controls class="w-100">
                    <source src="@(Url.Content("~/content/stevevideostore.mp4"))" type="video/mp4" />
                    Your browser does not support HTML5 video.
                </video>
            </div>
        </div>
    </div>
</div>

<script>
    (function() {
        var v = document.getElementById('myVideo');
        if (!v) return;
        // Ensure play attempt for browsers that require a play() call even when muted
        var p = v.play();
        if (p !== undefined) {
            p.catch(function () { /* autoplay prevented */ });
        }
    })();
</script>